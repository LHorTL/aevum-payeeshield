# QDay Aevum Testnet Configuration (Chain ID: 44005)
AEVUM_RPC_URL=https://rpc-test.qday.info
AEVUM_CHAIN_ID=44005
AEVUM_EXPLORER_URL=https://explorer-test.qday.info

# Official live tUSD8 ERC-20 token on Aevum Testnet (6 decimals)
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# Deployer private key (0x-prefixed hex). NEVER commit a real .env file!
# Generate locally with: npm run wallet:new
DEPLOYER_PRIVATE_KEY=

# Optional: Custom arbiter address for milestone escrow disputes (defaults to deployer)
ARBITER_ADDRESS=

# Optional: Rotation cooldown in seconds (default: 3600 = 1 hour on testnet; 86400 on mainnet)
ROTATION_COOLDOWN_SECONDS=3600
